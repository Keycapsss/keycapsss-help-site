{
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "eslint-plugin-vue": "^9.32.0",
    "markdownlint-cli2": "^0.20.0",
    "stylelint": "^16.12.0",
    "stylelint-config-standard": "^36.0.1",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.0",
    "vitepress": "~1.6.4",
    "vue-tsc": "^2.2.0"
  },
  "scripts": {
    "docs:dev": "vitepress dev docs",
    "docs:build": "npm run check && vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "lint": "eslint docs/.vitepress",
    "lint:fix": "eslint docs/.vitepress --fix",
    "lint:md": "markdownlint-cli2 \"docs/**/*.md\"",
    "typecheck": "vue-tsc --noEmit",
    "lint:css": "stylelint \"docs/.vitepress/**/*.css\"",
    "check": "npm run lint && npm run typecheck && npm run lint:css && npm run lint:md"
  },
  "dependencies": {
    "@miletorix/vitepress-youtube-embed": "~1.0.3"
  }
}
